# Optional overrides for `docker compose up -d --build`.
# The stack works without a .env file and generates its own persistent secrets.

PUBLIC_PORT=2323
ALLOWED_HOSTS=portfolio.mosquerasoft.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://portfolio.mosquerasoft.com
CORS_ALLOWED_ORIGINS=

SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO
ANALYTICS_TIME_ZONE=Europe/Madrid

# Gmail SMTP. Use a 16-character Google App Password, never your normal password.
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=jmosquera2305@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Jalberth Mosquera <jmosquera2305@gmail.com>
CONTACT_NOTIFICATION_EMAIL=jmosquera2305@gmail.com

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

DB_NAME=portfolio
DB_USER=portfolio
