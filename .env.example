# Copy this file to a path OUTSIDE the Git checkout on the production server.
# Never commit the real file.

# Docker Compose ingress (choose an unused loopback port on the server).
PUBLIC_PORT=2323

# Django
DEBUG=false
SECRET_KEY=
ALLOWED_HOSTS=portfolio.mosquerasoft.com
CSRF_TRUSTED_ORIGINS=https://portfolio.mosquerasoft.com
# Same-origin production does not require CORS. Leave empty unless another origin is added.
CORS_ALLOWED_ORIGINS=
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# PostgreSQL (production only)
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Vite uses /api in the production image. Local development keeps frontend/.env.
VITE_API_URL=/api
