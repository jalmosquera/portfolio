# Optional overrides for `docker compose up -d --build`.
# The stack works without a .env file and generates its own persistent secrets.

PUBLIC_PORT=2323
ALLOWED_HOSTS=portfolio.mosquerasoft.com,adminportfolio.mosquerasoft.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://portfolio.mosquerasoft.com
CORS_ALLOWED_ORIGINS=https://portfolio.mosquerasoft.com

SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO
ANALYTICS_TIME_ZONE=Europe/Madrid

# Resend HTTP API. Verify mosquerasoft.com in Resend before sending to visitors.
EMAIL_NOTIFICATIONS_ENABLED=true
CONTACT_EMAIL_ASYNC=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <noreply@mosquerasoft.com>
CONTACT_NOTIFICATION_EMAIL=jmosquera2305@gmail.com

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

DB_NAME=portfolio
DB_USER=portfolio
