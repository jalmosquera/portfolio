# Backend / Database
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=portfolio
DB_HOST=db
DB_PORT=5432
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,backend
# Comma-separated; set to your frontend origin if different
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost

# Frontend
# Use /api when running behind the nginx proxy in docker-compose
VITE_API_URL=/api
